{
  "manifest_version": 3,
  "name": "Floating Dark Mode Toggle",
  "version": "1.0",
  "description": "Adds a customizable floating button to toggle dark mode instantly on any web page.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}