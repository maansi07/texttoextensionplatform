{
  "manifest_version": 3,
  "name": "Universal Dark Mode Toggle",
  "version": "1.0",
  "description": "Toggle dark mode on any website with a sleek floating button.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}